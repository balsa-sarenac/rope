@startuml
left to right direction

skinparam monochrome true
skinparam shadowing false
skinparam roundcorner 0
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 45
skinparam ranksep 55
skinparam dpi 150

hide circle
hide empty members

class Refactoring
class Transformation

class RenameMethodRefactoring
class RenameMethodTransformation

class ChangeSignatureRefactoring
class ChangeSignatureTransformation

class _ArgumentChanger
class AddParameterRefactoring
class RemoveParameterRefactoring

class PendingChanges

Transformation <|-- Refactoring
Refactoring -right-> Transformation : decorates

Refactoring <|-- RenameMethodRefactoring
Refactoring <|-- ChangeSignatureRefactoring
Refactoring <|-- AddParameterRefactoring
Refactoring <|-- RemoveParameterRefactoring

Transformation <|-- RenameMethodTransformation
Transformation <|-- ChangeSignatureTransformation
Transformation <|-- _ArgumentChanger

ChangeSignatureTransformation o-- "ordered" _ArgumentChanger : children
AddParameterRefactoring --> _ArgumentChanger
RemoveParameterRefactoring --> _ArgumentChanger

ChangeSignatureTransformation --> PendingChanges
_ArgumentChanger --> PendingChanges : reads

@enduml
