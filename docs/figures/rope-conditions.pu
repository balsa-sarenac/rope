@startuml
top to bottom direction

skinparam monochrome true
skinparam shadowing false
skinparam roundcorner 0
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 50
skinparam dpi 150

hide circle

class Condition {
    violators
    check()
    subjects()
    error_string()
    not_()
}

class NegatedCondition {
    condition
    non_violators()
}

class _ArgumentChanger {
    change_definition_info()
    change_argument_mapping()
    configure()
    prepare_for_execution()
    applicability_preconditions()
    private_transform()
}

class RemoveParameterRefactoring {
    breaking_change_preconditions()
}

class ChangeSignatureTransformation {
    children
    run()
}

Condition <|-- NegatedCondition
NegatedCondition --> Condition

_ArgumentChanger --> Condition : applicability
RemoveParameterRefactoring --> _ArgumentChanger : decorates
RemoveParameterRefactoring --> Condition : behavior preserving
ChangeSignatureTransformation o-- "ordered" _ArgumentChanger

@enduml
